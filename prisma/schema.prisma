// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String        @id @default(cuid())
  name          String?
  email         String?       @unique
  emailVerified DateTime?
  image         String?
  accounts       Account[]
  entries        EnergyEntry[]
  journalEntries JournalEntry[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model EnergyEntry {
  id             Int      @id @default(autoincrement())
  date           DateTime
  createdAt      DateTime @default(now())
  mentalEnergy   Int // 1–10, excluding 7
  mentalNote     String?
  physicalEnergy Int // 1–10, excluding 7
  physicalNote   String?
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId, date])
}

model JournalEntry {
  id               Int      @id @default(autoincrement())
  date             DateTime
  createdAt        DateTime @default(now())
  successVision    String                                  // Morning: "What would success look like today?"
  achieved         Boolean?                                // Evening: Yes/No
  achievedNote     String?                                 // Evening: elaboration
  performanceScore Int?                                    // Evening: 1–10 (excluding 7)
  improvementNote  String?                                 // Evening: "What can I do to get to 10?"
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId, date])
}
